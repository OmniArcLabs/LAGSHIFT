<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\..\app\resources\branding\lagshift.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LAGSHIFT-1.0.4-Setup-Light</AssemblyName>
    <RootNamespace>Lagshift.Setup</RootNamespace>
    <Version>1.0.4.0</Version>
    <Company>OMNIARC</Company>
    <Authors>OMNIARC</Authors>
    <Product>LAGSHIFT Secure Setup</Product>
    <Description>LAGSHIFT Secure Installer</Description>
    <Copyright>Copyright 2026 OMNIARC. All rights reserved.</Copyright>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\lagshift-installer-background.png" Link="Assets\installer-background.png" />
    <Resource Include="..\..\app\resources\branding\lagshift.png" Link="Assets\lagshift.png" />
    <EmbeddedResource Include="E:\LAGSHIFT-Builds\engine\LAGSHIFT-1.0.4-Engine.exe" LogicalName="Lagshift.Setup.Payload.Engine.exe" />
  </ItemGroup>
</Project>
