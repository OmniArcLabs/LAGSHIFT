<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\app\resources\branding\lagshift.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LAGSHIFT-1.0.0-Setup</AssemblyName>
    <RootNamespace>Lagshift.Setup</RootNamespace>
    <Version>1.0.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\lagshift-installer-background.png" Link="Assets\installer-background.png" />
    <Resource Include="..\..\app\resources\branding\lagshift.png" Link="Assets\lagshift.png" />
    <EmbeddedResource Include="E:\LAGSHIFT-Builds\engine\LAGSHIFT-1.0.0-Engine.exe" LogicalName="Lagshift.Setup.Payload.Engine.exe" />
  </ItemGroup>
</Project>
